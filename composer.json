{
    "name": "fullscreeninteractive/silverstripe-abtesting",
    "description": "A/B test Silverstripe pages with weighted variations, CMS reporting, Google dataLayer events, and a pluggable tracking API for third-party analytics",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "cms",
        "ab testing",
        "experiment",
        "datalayer",
        "analytics",
        "conversion"
    ],
    "homepage": "https://github.com/fullscreeninteractive/silverstripe-abtesting",
    "support": {
        "issues": "https://github.com/fullscreeninteractive/silverstripe-abtesting/issues"
    },
    "authors": [
        {
            "name": "Fullscreen Interactive",
            "homepage": "https://www.fullscreen.io"
        },
        {
            "name": "Will Rossiter",
            "email": "will@fullscreen.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/admin": "^3",
        "symbiote/silverstripe-gridfieldextensions": "^5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "FullscreenInteractive\\ABTesting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FullscreenInteractive\\ABTesting\\Tests\\": "tests/php/"
        },
        "files": [
            "tests/php/Page.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "expose": [
            "client/dist"
        ],
        "screenshots": [
            "docs/en/images/experiment-edit.png",
            "docs/en/images/variations.png",
            "docs/en/images/reports.png"
        ]
    },
    "scripts": {
        "lint": "phpcs src/ tests/",
        "lint-clean": "phpcbf src/ tests/",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
